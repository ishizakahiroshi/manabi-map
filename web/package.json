{
  "name": "manabi-map-web",
  "private": true,
  "version": "0.7.0",
  "author": "Hiroshi Ishizaka (ishizakahiroshi) <ishizakahiroshi.dev@gmail.com>",
  "license": "AGPL-3.0-or-later",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "node scripts/build-school-observed.mjs",
    "build:ssr": "vite build --ssr src/entry-server.tsx --outDir dist-ssr",
    "gen:schools-json": "tsx scripts/gen-schools-json.mjs --school-source=sqlite-snapshot",
    "gen:dataset-fields": "node scripts/gen-dataset-fields.mjs",
    "typecheck": "tsc --noEmit -p tsconfig.app.json && tsc --noEmit -p tsconfig.functions.json",
    "lint": "node scripts/lint.mjs",
    "test": "vitest run && pnpm test:static && pnpm test:functions && pnpm test:school-source && pnpm test:local-data",
    "test:local-data": "python -B -m unittest discover -s ../scripts/local-data -p \"test_*.py\"",
    "test:restore": "python -B -m unittest discover -s ../scripts/local-data -p \"test_restore_*.py\"",
    "test:school-source": "tsx --test scripts/lib/school-source.test.mjs scripts/gen-schools-json-isolated.test.mjs scripts/school-publish-gate.test.mjs scripts/school-cutover-integration.test.mjs",
    "test:static": "node --test scripts/smoke-beacon.test.mjs scripts/smoke-config.test.mjs scripts/verify-static-output.test.mjs scripts/verify-deployment-capacity.test.mjs scripts/build-school-candidates.test.mjs scripts/build-school-observed.test.mjs scripts/serve-school-candidate.test.mjs scripts/lib/apex-candidate.test.mjs scripts/lib/school-release.test.mjs scripts/lib/school-release-producer.test.mjs scripts/lib/school-release-adapter.test.mjs scripts/lib/school-functions-package.test.mjs scripts/lib/school-resource-budget.test.mjs scripts/lib/school-pages-assets.test.mjs scripts/lib/school-seo-candidate.test.mjs scripts/lib/municipalities.test.mjs scripts/lib/dept-groups-shared.test.mjs scripts/lib/json-ld.test.mjs scripts/lib/brands.test.mjs",
    "test:functions": "node --test ../functions/api/admin/_auth.test.ts ../functions/api/csp-report.test.ts ../functions/_middleware.test.ts supabase/functions/trigger-snapshot-rebuild/handler.test.ts ../scripts/admission/schools-candidate-check.test.mjs ../scripts/admission/pdf-extract.test.mjs ../scripts/admission/official-fetch.test.mjs ../scripts/admission/mext-schools-fetch.test.mjs ../scripts/admission/gsi-batch-geocode.test.mjs ../scripts/admission/gen-admission-v2.test.mjs ../scripts/secrets-scan.test.mjs ../scripts/dashboard-snapshot.test.mjs ../scripts/check-migration-grants.test.mjs",
    "verify:static": "node scripts/verify-static-output.mjs --dist dist --max-file-mib 25",
    "verify:deployment": "node scripts/verify-deployment-capacity.mjs",
    "build:school-candidates": "node scripts/build-school-candidates.mjs",
    "check:budget": "node scripts/check-payload-budget.mjs --dist dist",
    "preview": "vite preview",
    "dev:kanji": "vite --config vite.kanji.config.ts",
    "build:kanji": "vite build --config vite.kanji.config.ts",
    "preview:kanji": "vite preview --config vite.kanji.config.ts"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.110.0",
    "leaflet": "^1.9.4",
    "leaflet.markercluster": "^1.5.3",
    "protomaps-leaflet": "^4.0.1",
    "qrcode.react": "^4.2.0",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "react-markdown": "^10.1.0",
    "react-router-dom": "^7.18.2",
    "remark-gfm": "^4.0.1"
  },
  "devDependencies": {
    "@ishizakahiroshi/vite-plugin-git-version": "^0.1.0",
    "@noble/hashes": "2.4.0",
    "@tailwindcss/vite": "^4.3.2",
    "@types/leaflet": "^1.9.21",
    "@types/leaflet.markercluster": "^1.5.6",
    "@types/node": "^24.13.2",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.3",
    "oxlint": "^1.71.0",
    "postcss": "8.5.25",
    "tailwindcss": "^4.3.2",
    "tsx": "^4.23.5",
    "typescript": "~6.0.2",
    "vite": "^8.1.1",
    "vitest": "^4.1.11"
  }
}

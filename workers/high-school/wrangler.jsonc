// 高校版の Workers（static assets）設定の正本。
// C8: docs/local/plan_parallel-school-restore-readiness.md（作者環境）/ 上位方針は geomap の plan_service-deploy-unification.md。
//
// このファイルは雛形で、`main` と `assets.directory` を持たない。候補ごとの隔離パッケージを
// web/scripts/workers-package.mjs が作るときに、検証済みの Worker 本体（`pages functions build --outdir` の
// raw index.js）と静的ファイルの置き場を足した設定を書き出す。Wrangler はその書き出し側を `--config` で読む。
//
// - Worker 本体はコンパイル済みの単一 ES module なので再バンドルしない（no_bundle）。送るバイトを候補の pin と一致させるため。
// - run_worker_first は候補の `_routes.json`（Pages Functions の include / exclude）と同じ範囲。
//   パッケージ作成時に `_routes.json` から作った値とここを突き合わせ、ずれていれば止める。
//   exclude 側（静的ファイル）は asset を先に配り、Worker のリクエスト数を消費しない。
// - not_found_handling / html_handling は Pages の既定（404.html を 404 で返す・末尾スラッシュ自動）に合わせる。
// - compatibility_date は Pages の manabi-map-high-school（2026-09-29 作成）の本番設定と同じ値。
// - 秘密（Cloudflare 側にだけ置く。値はリポに書かない）: SUPABASE_URL / SUPABASE_ANON_KEY（管理者判定の
//   functions/api/admin/_auth.ts が使う）、SUPABASE_SERVICE_ROLE_KEY（管理ダッシュボードの集計読み取り）。
//   登録は web/scripts/workers-publish.mjs の `secrets`（今の version のコードに秘密だけを足した Preview version を作る）。
//   無いと /api/admin/* は 404 になり、管理者でも /dashboard に入れない（2026-09-29 に実測）。
{
  "name": "manabi-map-high-school",
  "compatibility_date": "2026-09-29",
  "compatibility_flags": [],
  "no_bundle": true,
  "workers_dev": true,
  "preview_urls": true,
  "send_metrics": false,
  "assets": {
    "binding": "ASSETS",
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "404-page",
    "run_worker_first": [
      "/*",
      "!/assets/*",
      "!/school-data/*",
      "!/api/v1/*",
      "!/logos/*",
      "!/schools-*",
      "!/city-index-*",
      "!/school-name-index-*",
      "!/favicon.ico",
      "!/favicon.svg",
      "!/favicon-16.png",
      "!/favicon-32.png",
      "!/favicon-48.png",
      "!/apple-touch-icon.png",
      "!/icon-192.png",
      "!/icon-512.png",
      "!/icon.svg",
      "!/brand-mark.svg",
      "!/manifest.webmanifest",
      "!/og-hero.png",
      "!/robots.txt",
      "!/sitemap.xml",
      "!/llms.txt"
    ]
  }
}
